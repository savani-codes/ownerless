# Copy to .env at the repository root (scripts/setup.sh does it). It is gitignored.
# Optional settings for cognee-data-lab; the scripts export them before running Docker Compose.
# The DataHub token is read from ownerless.toml, so it lives in one place.

# The model Cognee uses to build its memory. Providers: openai, anthropic, gemini, groq, openrouter, ollama
LLM_PROVIDER_ID=
LLM_API_KEY=
LLM_MODEL_ID=
# Free-tier keys can hit rate limits while Cognee builds the graph:
# LLM_RATE_LIMIT_ENABLED=true
# LLM_RATE_LIMIT_REQUESTS=20
# LLM_RATE_LIMIT_INTERVAL=60

# The demo Airflow's admin password and API secret.
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_JWT_SECRET=local-dev-only-change-me
